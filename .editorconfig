root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Windows PowerShell 5.1 needs a BOM to read Vietnamese script text correctly.
[*.{ps1,psm1}]
charset = utf-8-bom

[*.cmd]
end_of_line = crlf
